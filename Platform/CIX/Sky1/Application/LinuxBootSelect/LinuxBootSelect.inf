[Defines]
	INF_VERSION                    = 0x00010006
	BASE_NAME                      = LinuxBootSelect
	FILE_GUID                      = 4F3DFC2A-3BB0-4f6a-8952-B5058B62F75B
	MODULE_TYPE                    = UEFI_APPLICATION
	VERSION_STRING                 = 0.1
	ENTRY_POINT                    = LinuxBootSelectEntry

[Binaries.AARCH64]
  PE32|LinuxBootSelect.efi|*

[Packages]
	MdePkg/MdePkg.dec
	MdeModulePkg/MdeModulePkg.dec
	EmbeddedPkg/EmbeddedPkg.dec
	Platform/CIX/Sky1/Sky1.dec

[Guids]

[Protocols]
  gEfiBlockIoProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  gEfiPartitionInfoProtocolGuid
  gEfiFirmwareVolume2ProtocolGuid

[Depex]
	TRUE
